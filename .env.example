# GEMINI_API_KEY: Optional default Gemini API key injected via AI Studio Secrets panel.
# Users can also paste and encrypt their Gemini API key directly inside the Maya app onboarding or Settings.
GEMINI_API_KEY=PLACEHOLDER_GEMINI_KEY
# GOOGLE_OAUTH_CLIENT_ID: Optional OAuth Client ID for YouTube Channel Analytics (youtube.readonly & yt-analytics.readonly).
GOOGLE_OAUTH_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
